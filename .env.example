# Copy to .env to override defaults. All optional.

# Port the local server listens on
PORT=5173

# Tool paths. Leave blank to auto-detect from PATH (recommended).
# Set explicitly only if a tool isn't on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=

# Where generated frame packages are written (relative to project root or absolute)
OUTPUT_DIR=output

# Safety cap on frames per job (UI budget is clamped to this)
MAX_FRAMES=60

# Long-edge pixel size frames are downscaled to (Claude image sweet spot)
FRAME_LONG_EDGE=1568
